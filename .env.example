# Copy this file to .env and fill in your own values. Commit this file, never .env.
# Claude is reached with the official Anthropic SDK through PydanticAI — this
# project does not use Portkey or any OpenAI-compatible gateway.

# Your own Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# The model for real questions, and the cheaper one for small talk and single
# lookups. See output/harness.md for how the router chooses.
MODEL_NAME=claude-opus-5
FAST_MODEL_NAME=claude-haiku-4-5

# Signs session tokens. Generate your own:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Without one the app still runs, but restarting the backend signs everyone out.
SESSION_SECRET=generate-your-own-random-hex-string

# Port the FastAPI backend listens on. The Vite dev proxy expects 8000.
BACKEND_PORT=8000
